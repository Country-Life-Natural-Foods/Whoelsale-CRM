# Shopify Staff Assignment App Configuration

# Your app's API key and secret from Partner Dashboard
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Your app's URL (use ngrok for local development)
SHOPIFY_APP_URL=https://your-app-url.ngrok.io

# Session secret (generate a random string)
SESSION_SECRET=your_session_secret_here

# Production on Vercel — use ONE of these (both are free-tier friendly):
# Option A: Upstash/Vercel Redis
REDIS_URL=redis://default:password@host:6379
# Option B: Neon or Supabase Postgres (no Redis)
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Environment
NODE_ENV=development

# Optional: Enable debug logging
DEBUG=false

# --- B2B Map Sync (required for "Run Map Sync") ---
# Shop domain is taken from the logged-in session in the embedded app.
# Set this for cron / CLI runs (npm run sync-b2b-map):
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Mapbox token used to geocode company addresses (same as theme map section):
# MAPBOX_ACCESS_TOKEN=pk.xxxx

# Optional auth for cron/CLI when not using an embedded session:
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxx
# or client credentials (defaults to SHOPIFY_API_KEY / SHOPIFY_API_SECRET if unset):
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# --- Reporting API (/api/reporting/v1, read-only; see docs/REPORTING_API.md) ---
# Off until set. 32+ random characters: openssl rand -base64 48
# Rotate by setting "old,new", moving the client to new, then removing old.
# REPORTING_API_KEY=
# Store to report on (optional when only one store has synced orders):
# REPORTING_SHOP=your-store.myshopify.com
# Browser origins allowed to call it (leave empty: server-to-server only):
# REPORTING_API_CORS_ORIGINS=

# --- MCP connector (/mcp, for Claude; see docs/MCP.md) ---
# Uses REPORTING_API_KEY (sign-in page) and DATABASE_URL (token store). Optional:
# Pin the public origin if a proxy rewrites Host (normally leave unset):
# MCP_PUBLIC_URL=https://your-app.vercel.app
# Extra OAuth redirect hosts besides claude.ai / claude.com / loopback:
# MCP_OAUTH_REDIRECT_HOSTS=
